PORT=3000
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
NEON_AUTH_URL="https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth"
VITE_NEON_AUTH_URL="https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth"
# Dev/preview only: skip login (client) and token checks (server). Ignored when VERCEL_ENV=production.
VITE_DISABLE_AUTH=false
# AI Vision (Beta) food recognition. Server-only: never prefix these with VITE_.
GEMINI_API_KEY=""
# Optional; any vision-capable Gemini Flash model. Defaults to gemini-flash-latest.
GEMINI_MODEL=""
# External Product - UPCitemdb API Key (UPCitemdb trial endpoint only allows about 100 requests per day)
GOUPC_API_KEY=""
