# Copy to .env.local for local development.
# Server/drizzle load .env.local before .env. VITE_* values are public at build time.

# Optional: Express API port; default 3000. Choose locally, no provider key needed.
# Vite's /api proxy targets localhost:3000, so keep this value for normal local dev.
PORT=3000

# Required: secret Neon PostgreSQL connection URL for app data and drizzle-kit.
# Neon Console (https://console.neon.tech): select project/branch, then Connect.
# Copy the connection string for the intended database/role; keep SSL enabled.
# The connection string here in .env.example is a throwaway testing branch of the database, use to test without creating a new empty database.
DATABASE_URL=postgresql://neondb_owner:npg_MjFfs0mTtbZ1@ep-snowy-resonance-b5i8zggp-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Required for authenticated API requests and Neon webhook signature verification.
# Neon Console: project > branch > Auth > Configuration > Auth URL (docs/auth.md).
# Use the same Neon branch as DATABASE_URL; this is an endpoint, not an API key.
# The auth url here in .env.example is from a throwaway testing branch of the database, use to test without creating a new Neon database.
NEON_AUTH_URL="https://ep-snowy-resonance-b5i8zggp.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth"

# Required for browser authentication: copy NEON_AUTH_URL above, not DATABASE_URL.
# Public build-time URL; restart Vite/rebuild after changing it.
# The auth url here in .env.example is from a throwaway testing branch of the database, use to test without creating a new Neon database.
VITE_NEON_AUTH_URL="https://ep-snowy-resonance-b5i8zggp.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth"

# Optional local choice, no provider key: exact true skips login and API token checks.
# Default off; dev/preview only. Ignored when VERCEL_ENV=production.
VITE_DISABLE_AUTH=false

# Optional for core inventory; required for AI Vision and AI-assisted expiry matching.
# Secret server-only key: create in Google AI Studio (https://aistudio.google.com/apikey).
# Never prefix API keys with VITE_. Requests are billed to this key's project.
GEMINI_API_KEY=""

# Optional server model override: blank uses gemini-flash-latest for AI Vision.
# Also supplies the expiry model unless EXPIRY_AI_MODEL is set. Choose a compatible
# vision-capable model ID from https://ai.google.dev/gemini-api/docs/models.
GEMINI_MODEL=""

# Optional secret server-only barcode provider key. Obtain from a Go-UPC API account:
# https://go-upc.com/api-documentation. Without it, Open Food Facts and UPCitemdb
# are still queried by the normalizer; neither needs a key in this integration.
GO_UPC_API_KEY=""

# Optional server-only expiry controls (expiry-tests/gemini-expiry.ts).
# These are local choices, not credentials. Local matching runs first; without
# GEMINI_API_KEY no expiry request goes to Gemini, regardless of these switches.

# Flags default on when unset/blank: 1/true/yes/on enables (case-insensitive);
# any other nonblank value disables. Master switch affects both paths.
# EXPIRY_AI_FALLBACK_ENABLED=false

# Optional: disable only shortlist tie-breaking or only query expansion.
# EXPIRY_AI_TIE_BREAK_ENABLED=false
# EXPIRY_AI_EXPANSION_ENABLED=false

# Optional model ID from Google's model docs above; precedence is EXPIRY_AI_MODEL,
# then GEMINI_MODEL, then gemini-flash-lite-latest. Availability depends on project.
# EXPIRY_AI_MODEL=""

# Optional request timeout in milliseconds (default 1500) and output token cap (256).
# EXPIRY_AI_TIMEOUT_MS=1500
# EXPIRY_AI_MAX_OUTPUT_TOKENS=256

# Optional sampling temperature; unset uses the model default. Check model support.
# EXPIRY_AI_TEMPERATURE=1

# Optional thinking mode: default (no override), minimal, or budget.
# Compatibility depends on the chosen model; unsupported settings can fail requests.
# EXPIRY_AI_THINKING=default
